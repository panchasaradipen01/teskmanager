# ==========================================
# TaskPulse - Environment Variables Template
# ==========================================
# Copy this file to .env in your server and client directories or set these in your hosting environment.
# Never commit real credentials to version control.

# ------------------------------------------
# General Application Configuration
# ------------------------------------------
NODE_ENV=development
APP_NAME=TaskPulse
COMPANY_NAME=TaskPulse Technologies
DEFAULT_TIMEZONE=Asia/Kolkata
PORT=5000

# ------------------------------------------
# Client / Frontend Configuration
# ------------------------------------------
NEXT_PUBLIC_APP_NAME=TaskPulse
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata

# ------------------------------------------
# Server & CORS Configuration
# ------------------------------------------
CLIENT_URL=http://localhost:3000

# ------------------------------------------
# Database (MongoDB Atlas / Local)
# ------------------------------------------
# Local development default:
MONGODB_URI=mongodb://127.0.0.1:27017/taskpulse
# Production MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskpulse?retryWrites=true&w=majority

# ------------------------------------------
# Authentication & Security
# ------------------------------------------
# Generate a secure 64-character hex string in production: openssl rand -hex 32
JWT_SECRET=super_secret_jwt_key_change_me_in_production_min_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_NAME=taskpulse_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ------------------------------------------
# Initial Bootstrap Admin
# ------------------------------------------
# Used by `npm run seed:admin`
INITIAL_ADMIN_EMAIL=admin@taskpulse.com
INITIAL_ADMIN_PASSWORD=Admin@TaskPulse2026!
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_EMP_ID=EMP-0001
INITIAL_ADMIN_DEPT=Executive

# ------------------------------------------
# Business Logic Configuration
# ------------------------------------------
# Maximum backdating days allowed for regular employees without admin override (Default: 1 = yesterday)
MAX_TASK_BACKDATE_DAYS=1
# Rate limiting window in minutes and maximum requests
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
