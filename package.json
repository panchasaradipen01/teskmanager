{
  "name": "taskpulse-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build": "npm run build:server && npm run build:client",
    "test:server": "npm run test --workspace=server",
    "seed:admin": "npm run seed:admin --workspace=server",
    "deploy:client": "npm run build:client && wrangler pages deploy client/out --project-name taskpulse"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wrangler": "^4.154.0"
  }
}
